# law-nexus local environment (copy to .env; .env is gitignored)

# Root of the read-only ConsultantPlus export (4.6 GB, gitignored).
# Skip-capable tests and the harness corpus-grounding probe resolve real corpus paths as
# $CONSULTANT_EXPORT_DIR/consru_export/exports/...
# Default when unset or empty/whitespace: consru_export
CONSULTANT_EXPORT_DIR=consru_export

# Durable append-only JSONL ledger of applied external effects
# (ln-replay JsonlEffectLedger, EffectLedgerPort). Required for durable replay:
# fail-closed when unset, empty, or whitespace-only - no default is substituted
# (unlike CONSULTANT_EXPORT_DIR above). Point at a dedicated file path.
EFFECT_LEDGER_PATH=
