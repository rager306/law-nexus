{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalgraph.local/schemas/s08-findings.v1.json",
  "title": "S08 Final Architecture Review Findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_artifacts",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "s08-final-architecture-findings/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "s07_review_findings",
        "s04_falkordb_smoke",
        "s05_odt_parser_findings",
        "s09_local_embedding_evaluation",
        "s10_embedding_runtime_proof"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "summary"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source",
        "claim_class",
        "status",
        "severity",
        "evidence",
        "impact",
        "recommendation",
        "owner",
        "resolution_path",
        "verification_criteria",
        "roadmap_effect",
        "requirement_links"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*[0-9][A-Z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_class": {
          "type": "string",
          "enum": [
            "prd-fixed",
            "deferred-proof-gate",
            "confirmed-runtime-bounded",
            "parser-smoke-bounded",
            "prior-art-bounded",
            "embedding-boundary",
            "out-of-scope-guardrail"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "fixed",
            "deferred",
            "confirmed-runtime",
            "blocked-environment",
            "bounded",
            "excluded"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "BLOCKER",
            "MAJOR",
            "MINOR",
            "INFO"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_entry"
          }
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "resolution_path": {
          "type": "string",
          "minLength": 1
        },
        "verification_criteria": {
          "type": "string",
          "minLength": 1
        },
        "roadmap_effect": {
          "type": "string",
          "minLength": 1
        },
        "requirement_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "decision_links": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
