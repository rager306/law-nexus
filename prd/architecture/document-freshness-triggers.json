{
  "schema_version": "law-nexus-document-freshness-triggers/v1",
  "authoritative": false,
  "boundary": "Repository change-impact diagnostics only; matching or passing a trigger does not validate document semantics, product behavior, legal correctness, or lifecycle.",
  "triggers": [
    {
      "id": "adr-contract-change",
      "sources": ["doc/adr/0*.md"],
      "required_any": ["prd/ARCHITECTURE.md", "doc/adr/README.md", "doc/adr-architecture-cross-matrix.md"],
      "review": "Recheck lifecycle, index, supersession and living-oracle projection."
    },
    {
      "id": "architecture-oracle-change",
      "sources": ["prd/ARCHITECTURE.md"],
      "required_any": ["README.md", "prd/project-state/roadmap.md", "prd/project-state/data/roadmap.json"],
      "review": "Recheck cold-reader direction and process-front projections."
    },
    {
      "id": "product-change",
      "sources": ["prd/PRODUCT.md"],
      "required_any": ["prd/REQUIREMENTS.md"],
      "review": "Recheck the Product-to-Requirement trace and proof ceilings."
    },
    {
      "id": "requirement-change",
      "sources": ["prd/REQUIREMENTS.md"],
      "required_any": ["prd/PRODUCT.md"],
      "review": "Recheck the Requirement-to-Product inverse trace and proof ceilings."
    },
    {
      "id": "archive-policy-change",
      "sources": [".gitignore", "prd/migration/decommission/*.json", "prd/migration/*decommission*.md"],
      "required_any": ["src/law_nexus_harness/governor.py", "tests/test_harness_governor.py", "assessment/07-adr-archive-governor-audit.md"],
      "review": "Recheck ignored versus tracked vaults, active aliases and archive manifest integrity."
    },
    {
      "id": "governor-contract-change",
      "sources": ["src/law_nexus_harness/governor.py", "src/law_nexus_harness/cli.py", "src/law_nexus_harness/adr_matrix.py"],
      "required_any": ["tests/test_harness_governor.py", "tests/test_harness_adr_matrix.py", "tests/test_harness_review_case_cli.py", "prd/architecture/adr-governor-verification-design.md"],
      "review": "Recheck report compatibility, exit semantics, negative tests and non-claims."
    },
    {
      "id": "temporal-glossary-change",
      "sources": ["prd/temporal-legal-model.md"],
      "required_any": ["prd/architecture/temporal-vocabulary-contract.json", "prd/architecture/temporal-semantic-gap-register.md", "prd/architecture/glossary-governance.md"],
      "review": "Recheck owning ADR, canonical name, status, fail-closed boundary, catalog row and unresolved semantic gaps."
    },
    {
      "id": "temporal-vocabulary-catalog-change",
      "sources": ["prd/architecture/temporal-vocabulary-contract.json"],
      "required_any": ["prd/temporal-legal-model.md", "prd/architecture/temporal-semantic-gap-register.md", "prd/architecture/glossary-governance.md"],
      "review": "Recheck complete glossary-row and gap-ID inventory without treating the catalog as semantic authority."
    },
    {
      "id": "temporal-gap-register-change",
      "sources": ["prd/architecture/temporal-semantic-gap-register.md"],
      "required_any": ["prd/temporal-legal-model.md", "prd/architecture/temporal-vocabulary-contract.json", "prd/architecture/glossary-governance.md"],
      "review": "Recheck glossary impact and vocabulary inventory; a companion edit does not close or promote a gap."
    },
    {
      "id": "glossary-governance-change",
      "sources": ["prd/architecture/glossary-governance.md"],
      "required_any": ["prd/temporal-legal-model.md", "prd/architecture/temporal-vocabulary-contract.json", "prd/architecture/adr-governor-verification-design.md"],
      "review": "Recheck injection/update rules against the live glossary and Governor boundary; governance remains non-authoritative."
    },
    {
      "id": "review-case-contract-change",
      "sources": ["prd/architecture/review-case.schema.json", "prd/architecture/review-cases/**/*.json", "src/law_nexus_harness/review_case/**/*.py"],
      "required_any": ["doc/adr/0024-review-case-intake-and-disposition.md", "prd/architecture/review-cases/README.md", "prd/architecture/review-cases/review-11-12-delta-map.md", "tests/test_review_case_schema.py", "tests/test_review_case_delta_fixture.py", "tests/test_review_case_delta_map.py", "tests/test_review_case_pydantic_codec.py", "tests/test_review_case_filesystem_adapters.py", "tests/test_harness_review_case_cli.py", "tests/test_review_case_replay.py", "tests/test_review_case_event_ledger.py", "tests/test_review_case_ledger_application.py", "tests/test_review_case_governor.py"],
      "review": "Recheck packet non-authority constants, source hashes and spans, human disposition firewall, revision-bound proof classes, adapter-only codec/filesystem/ledger boundaries, CLI non-promotion, append-only envelope integrity, Governor structural-versus-advisory boundary, pure delta inventory non-claims, and explicit non-claims; a valid packet, CLI exit 0, ledger receipt, advisory open inventory, or delta map does not accept or close findings."
    }
  ]
}
