{
  "schema_version": "law-nexus/repository-quality-gate/v1",
  "status": "active",
  "phase": "rust-product-python-harness",
  "local_config": ".pre-commit-config.yaml",
  "ci_workflow": ".github/workflows/repository-quality.yml",
  "checks": [
    {
      "id": "ruff-check-python",
      "command": "uv run ruff check <staged-python-files>",
      "scope": "staged active Python files; python_archive excluded"
    },
    {
      "id": "ruff-format-python",
      "command": "uv run ruff format --check <staged-python-files>",
      "scope": "staged active Python files; python_archive excluded"
    },
    {
      "id": "cargo-fmt-rust",
      "command": "cargo fmt --all -- --check",
      "scope": "staged Cargo and Rust paths"
    },
    {
      "id": "cargo-check-rust",
      "command": "cargo check --workspace --offline",
      "scope": "staged Cargo and Rust paths"
    },
    {
      "id": "cargo-clippy-rust",
      "command": "cargo clippy --workspace --offline --all-targets -- -D warnings",
      "scope": "staged Cargo and Rust paths"
    },
    {
      "id": "crate-dependency-allowlist",
      "command": "uv run python scripts/verify-crate-dependency-allowlist.py",
      "scope": "workspace path-dependency graph; Cargo and allowlist paths"
    },
    {
      "id": "architecture-claim-conformance",
      "command": "uv run python scripts/verify-adr-conformance.py",
      "scope": "living architecture and ADR records"
    }
  ],
  "ci_process_suite": [
    "tests/test_harness_status_tracer.py",
    "tests/test_harness_subprocess_failure_modes.py",
    "tests/test_harness_no_forbidden_imports.py",
    "tests/test_harness_governor.py",
    "tests/test_harness_cli_entrypoints.py",
    "tests/test_harness_preflight.py",
    "tests/test_harness_review_case_cli.py",
    "tests/test_review_case_governor.py",
    "tests/test_review_case_schema.py",
    "tests/test_review_case_delta_fixture.py",
    "tests/test_documentation_navigation.py",
    "tests/test_repository_quality_gate.py",
    "tests/test_verify_crate_dependency_allowlist.py",
    "tests/test_verify_port_contract_coverage.py",
    "tests/test_verify_hostile_negative_suite_coverage.py",
    "tests/test_verify_multi_adapter_port_coverage.py",
    "tests/test_verify_live_adapter_readiness.py",
    "tests/test_architecture_views.py",
    "tests/test_architecture_analysis_views.py",
    "tests/test_architecture_remediation_matrix.py",
    "tests/test_architecture_track_split.py",
    "tests/test_architecture_closure_roadmap.py",
    "tests/test_architecture_registry_schema.py",
    "tests/test_verify_adr_conformance.py"
  ],
  "ci_inventory_scripts": [
    "scripts/verify-port-contract-coverage.py",
    "scripts/verify-hostile-negative-suite-coverage.py",
    "scripts/verify-multi-adapter-port-coverage.py",
    "scripts/verify-live-adapter-readiness.py"
  ],
  "forbidden_active_dependencies": [
    "git-lex executable",
    ".lex generated state",
    "archived semantic kits",
    "archived architecture projections",
    "Python product package imports in harness"
  ],
  "future_additions": [
    "cargo test pre-commit gating",
    "cargo audit/deny",
    "repository harness document freshness",
    "Rust artifact parity",
    "optional inventory --strict CI policy decision (port/hostile/multi-adapter inventories already green as bounded mention-based process surfaces; not TEI/RuVector validation)"
  ],
  "product_logic_in_python_harness_allowed": false,
  "non_claims": [
    "CI process suite and inventory scripts are process honesty surfaces only.",
    "Does not validate live TEI/RuVector adapters or product readiness."
  ]
}
